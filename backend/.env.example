# ============================================================
# BrandShield AI — Backend Environment Variables Template
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ============================================================

APP_ENV=development
APP_DEBUG=true
APP_SECRET_KEY=change-this-to-a-long-random-string

# ── Database ──────────────────────────────────────────────────
# Option 1 — SQLite (local dev, no Docker required):
DATABASE_URL=sqlite+aiosqlite:///./brandshield.db

# Option 2 — PostgreSQL (when available):
# DATABASE_URL=postgresql+asyncpg://brandshield:your_password@localhost:5432/brandshield

# ── AI / LLM ──────────────────────────────────────────────────
# Leave all blank to use the deterministic template fallback (safe for demo).
# For live AI mode: set AI_PROVIDER=openai and AI_API_KEY=sk-...
AI_PROVIDER=
AI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_MAX_TOKENS=800
AI_TIMEOUT_SECONDS=15
# Legacy variable (still supported):
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ── CORS ──────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000

# ── Demo ──────────────────────────────────────────────────────
DEMO_MODE=true
