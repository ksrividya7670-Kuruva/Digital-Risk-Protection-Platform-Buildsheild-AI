# ============================================================
# BrandShield AI — .gitignore
# ============================================================

# ── Environment / Secrets ────────────────────────────────────
.env
.env.local
.env.*.local
*.pem
*.key

# ── Python ───────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/
pip-log.txt
pip-delete-this-directory.txt
.tox/
.nox/
.cache/
.pytest_cache/
.mypy_cache/
.ruff_cache/
htmlcov/
.coverage
coverage.xml
*.cover
venv/
.venv/
env/
ENV/

# ── Node / Next.js ───────────────────────────────────────────
node_modules/
.next/
out/
.vercel/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
*.tsbuildinfo

# ── IDEs ─────────────────────────────────────────────────────
.vscode/settings.json
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# ── Docker ───────────────────────────────────────────────────
# (docker-compose.yml is committed; .env is not)

# ── Data ─────────────────────────────────────────────────────
# Keep the data directory structure but not actual data files
data/brands/*.json
data/candidates/*.json
data/evidence/*.json

# ── SQLite database (dev only, not committed) ─────────────────
*.db
*.db-shm
*.db-wal

# ── Logs ─────────────────────────────────────────────────────
*.log
logs/
